# === Serveur ===
PORT=5000
NODE_ENV=development

# Origine(s) autorisée(s) par CORS, séparées par des virgules
CORS_ORIGIN: "*"

# === Base de données ===
MONGO_URI=mongodb://localhost:27017/jwt-refresh-demo

# === JWT ===
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m

REFRESH_TOKEN_SECRET=change-me-too
REFRESH_TOKEN_TTL_SEC=604800

# === Réinitialisation de mot de passe ===
# URL du frontend, utilisée pour construire le lien envoyé par e-mail
FRONTEND_URL=http://localhost:3000

# Durée de vie du jeton de reset, en secondes (900 = 15 min)
PASSWORD_RESET_TTL_SEC=900

# === SMTP (envoi d'e-mails) ===
SMTP_HOST=smtp.gmail.com 
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=dkhili.saber@gmail.com
SMTP_PASS=***********
MAIL_FROM=dkhili.saber@gmail.com
